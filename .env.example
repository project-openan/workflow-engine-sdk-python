# A2A-T SDK Configuration
# Copy this file to .env and fill in your values

# Prompt runtime
A2AT_LANGUAGE=zh-CN
# local_file: prompt resources are loaded from local filesystem
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_PROMPT_COMPLIANCE_GUARDRAIL_PROVIDER=noop

# LLM runtime
# deepseek is OpenAI-compatible: use the openai provider client with deepseek's base_url/model/key
A2AT_LLM_PROVIDER=deepseek
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=your-api-key-here
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100

# Negotiation
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory

# Credential encryption key (32-byte hex, used for enc: prefixed passwords in credentials JSON)
# Generate with: openssl rand -hex 32
A2AT_CRED_KEY=your-32-byte-hex-key-here
